# Django settings
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///db.sqlite3
# MySQL (uncomment and fill in your XAMPP credentials):
# DATABASE_URL=mysql://root:@127.0.0.1:3306/telemed_db

# Email configuration (logs to console by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email (e.g. Gmail SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
